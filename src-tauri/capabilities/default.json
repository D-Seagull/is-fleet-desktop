{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the IS Fleet desktop shell.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://app.isfleet.eu",
      "https://*.vercel.app",
      "http://localhost:3000"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-overlay-icon",
    "allow-show-notification",
    "allow-reveal-download",
    "notification:default"
  ]
}
