{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IS Fleet",
  "version": "0.2.1",
  "identifier": "com.dseadull.isfleet",
  "build": {
    "frontendDist": "https://app.isfleet.eu",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "IS Fleet",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwRTRGRTU1M0U4OEE1NzEKUldSeHBZZytWZjdrUUppQWN2NEloVWZObS9NQUNjTFQ0UEFGZFMxT1cyZTdVZDdWWWpyT1I5aisK",
      "endpoints": [
        "https://github.com/D-Seagull/is-fleet-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
